{
  "entities": {
    "Worker": {
      "title": "Worker",
      "description": "A staff member who can be scheduled for shifts.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "position": { "type": "string" },
        "color": { "type": "string" },
        "maxHours": { "type": "number" }
      },
      "required": ["name", "position", "color", "maxHours"]
    },
    "Location": {
      "title": "Location",
      "description": "A physical location where shifts take place.",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "User": {
      "title": "User",
      "description": "An authenticated user of the system.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["boss", "manager", "worker"] },
        "worker_id": { "type": "string", "description": "Optional reference to a Worker document" }
      },
      "required": ["email", "role"]
    },
    "Shift": {
      "title": "Shift",
      "description": "A scheduled work period for a worker at a location.",
      "type": "object",
      "properties": {
        "location_id": { "type": "string" },
        "worker_id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["location_id", "worker_id", "date", "start_time", "end_time"]
    }
  },
  "firestore": {
    "/workers/{workerId}": {
      "schema": { "$ref": "#/entities/Worker" },
      "description": "Collection of all workers."
    },
    "/locations/{locationId}": {
      "schema": { "$ref": "#/entities/Location" },
      "description": "Collection of all locations."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user profiles linked to Firebase Auth UID."
    },
    "/shifts/{shiftId}": {
      "schema": { "$ref": "#/entities/Shift" },
      "description": "Collection of all scheduled shifts."
    }
  }
}
